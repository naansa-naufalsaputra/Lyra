rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Validation for task data
    function isValidTask(data) {
      return data.userId == request.auth.uid &&
             data.text is string && 
             data.text.size() > 0 &&
             data.completed is bool &&
             data.priority in ["low", "medium", "high"];
    }

    // Tasks collection rules
    match /tasks/{taskId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId) && isValidTask(request.resource.data);
      allow create: if isOwner(request.resource.data.userId) && isValidTask(request.resource.data);
    }

    // Categories collection rules
    match /categories/{categoryId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    // Recurrence Rules collection rules
    match /recurrenceRules/{ruleId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    // Default deny for everything else
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
